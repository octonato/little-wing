{
  "name": "little-wing",
  "version": "0.1.1",
  "description": "Little Wing Chrome Extension",
  "type": "module",
  "scripts": {
    "build": "bun run src/build.ts",
    "build:prod": "bun run src/build.ts --production",
    "dev": "bun --watch run src/build.ts",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --write src/",
    "format": "bunx @biomejs/biome format --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "bun-types": "^1.3.10",
    "chrome-types": "^0.1.422"
  }
}
